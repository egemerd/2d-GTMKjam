  entries:
  - text: EEvery calendar in the universe has vanished except one.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: And it belongs to you.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: A precious object. Handle it with care.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: With this calendar comes a duty one of great importance.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: Humans, creatures, every living being in the universe now comes to you.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: You are an Age Officer.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  defaultCharDelay: 0.04
  defaultHoldAfter: 1.5
