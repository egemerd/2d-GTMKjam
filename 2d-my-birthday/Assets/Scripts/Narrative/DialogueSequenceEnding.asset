  entries:
  - text: Wwhat are those? Are those pins?
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: What do they do?
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: Oh...
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: So you calculate my age with those.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: Each pin is a day, I see. That's kind of cool.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: It makes me pretty old, I guess.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: These pins... they must be heavy. Or maybe they are, I don't know...
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: Just don't throw them around like that.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  - text: ...like I did.
    charDelayOverride: 0
    holdAfterOverride: 0
    waitForInput: 0
  defaultCharDelay: 0.04
  defaultHoldAfter: 1.5
